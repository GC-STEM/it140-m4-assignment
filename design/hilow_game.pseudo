START hilow_game

    # Establish a valid guessing range.
    OUTPUT "Enter the lower bound: "
    INPUT lower_bound
    OUTPUT "Enter the upper bound: "
    INPUT upper_bound

    WHILE upper_bound <= lower_bound
        OUTPUT "Error: Upper bound must be greater than lower bound."
        OUTPUT "Re-enter the upper bound: "
        INPUT upper_bound
    END WHILE

    # Establish the number the player is trying to guess.
    secret_number = RANDOM_INTEGER(lower_bound, upper_bound)

    # Play the game.
    OUTPUT "Enter your guess between ", lower_bound, " and ", upper_bound, ": "
    INPUT guess

    # Validate the initial guess
    WHILE guess < lower_bound OR guess > upper_bound
        OUTPUT "Error: Guess must be between ", lower_bound, " and ", upper_bound, "."
        OUTPUT "Re-enter your guess: "
        INPUT guess
    END WHILE

    # Game loop until the correct number is guessed
    WHILE guess != secret_number
        IF guess < secret_number THEN
            OUTPUT "Too low!"
        ELSE
            OUTPUT "Too high!"
        END IF
        
        OUTPUT "Enter your next guess: "
        INPUT guess

        # Validate the new guess
        WHILE guess < lower_bound OR guess > upper_bound
            OUTPUT "Error: Guess must be between ", lower_bound, " and ", upper_bound, "."
            OUTPUT "Re-enter your guess: "
            INPUT guess
        END WHILE
    END WHILE

    OUTPUT "Congratulations! You guessed the correct number: ", secret_number

END hilow_game

