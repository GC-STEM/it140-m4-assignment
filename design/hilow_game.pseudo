# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template
#
# Complete the TODO prompts below with your own pseudocode.
# Keep this file in .pseudo format for submission.
#
# Use clear indentation to show decisions and repeated behavior.
# Your finished pseudocode should address every requirement in the
# current Module Four Assignment Guidelines and Rubric.

START hilow_game

    # Establish a valid guessing range.
    INPUT lower_bound
    INPUT upper_bound
    WHILE lower_bound >= upper_bound
OUTPUT "The lower bound must be less than the upper bound."
INPUT lower_bound
INPUT upper_bound
END WHILE

    # Establish the number the player is trying to guess.
    SET target_number = RANDOM(lower_bound, upper_bound)

    # Play the game.
    INPUT guess
 WHILE guess < lower_bound OR guess > upper_bound

 OUTPUT "Guess must be between the lower and upper bounds."
    INPUT guess
END WHILE
WHILE guess != target_number
    IF guess < target_number
            OUTPUT "Nope, too low."
    ELSE IF guess > target_number
        OUTPUT "Nope, too high."
        END IF
    INPUT guess
    WHILE guess < lower_bound OR guess > upper_bound
        OUTPUT "Guess must be between the lower and upper bounds."
        INPUT guess
    END WHILE
END WHILE
OUTPUT "You got it!"
END hilow_game




