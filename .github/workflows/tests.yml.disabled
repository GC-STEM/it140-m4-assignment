# This workflow is intentionally disabled because Python construction and testing
# are optional practice for the Module Four Assignment. The active repository
# checks are in tests.yml; do not rename this file to tests.yml.
name: Optional Python Practice Tests

on:
  push:
  workflow_dispatch:

jobs:
  practice-tests:
    runs-on: ubuntu-24.04
    steps:
      - name: Check out repository
        uses: actions/checkout@v7
      - name: Set up Python
        uses: actions/setup-python@v7
        with:
          python-version: "3.12"
      - name: Run optional acceptance tests
        run: python3 tests/test_hilow_game.py
