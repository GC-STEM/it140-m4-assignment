# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template
#
# Complete the TODO prompts below with your own pseudocode.
# Keep this file in .pseudo format for submission.
#
# Use clear indentation to show decisions and repeated behavior.
# Your finished pseudocode should address every requirement in the
# current Module Four Assignment Guidelines and Rubric.

START hilow_game

    # Establish a valid guessing range.
    Obtain the lower bound from the user
    Obtain the upper bound from the user

    WHILE lower bound is greater than or equal to upper bound
        Display "The lower bound must be less than the upper bound."
        Obtain the lower bound from the user
        Obtain the upper bound from the user
    END WHILE

    # Establish the number the player is trying to guess.
    Generate a random number between the lower bound and upper bound

    # Play the game.
    Obtain a guess from the user

    WHILE guess is less than the lower bound OR guess is greater than the upper bound
        Display "The guess must be between the lower and upper bounds."
        Obtain another guess from the user
    END WHILE

    WHILE guess is not equal to the random number
        IF guess is less than the random number
            Display "Too low."
        ELSE
            Display "Too high."
        END IF

        Obtain another guess from the user

        WHILE guess is less than the lower bound OR guess is greater than the upper bound
            Display "The guess must be between the lower and upper bounds."
            Obtain another guess from the user
        END WHILE
    END WHILE

    Display "Correct!"

END hilow_game




