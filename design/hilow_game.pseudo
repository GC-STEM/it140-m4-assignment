START hilow_game

# Establish a valid guessing range 
Import random.
Get: Input player_name.
Print:"Welcome to the higher/Lower Game, " + player_name + "!"

# Establish the number the player is trying to guess.
Get: Input lower_bound.
Get: Input Upper_bound.
    
#Validate bounds
if upper_bound < lower_bound THEN
    print:" Lower bound must be less than upper bound."
else
# Generate random number between bounds
Set random_number = random between lower_bound and upper_bound

#Loop until correct guess
While true DO
GET: Input user_guess
IF user_guess == random_number THAN
    PRINT: "You got it"
ELSE IF user_guess < random_number THAN
    PRINT: "Nope, too low"
ELSE IF user_guess > random_number THAN
    PRINT: "Nope, too high"
ELSE 
    PRINT: "Invalid guess. Please enter a number betwwen" + {lower_bound} + {upper_bound} + "."
    Break

END hilow_game

