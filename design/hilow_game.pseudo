# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode
#
# Use clear indentation to show decisions and repeated behavior.

START hilow_game

    # Establish a valid guessing range.
    DISPLAY "Enter the lower number:"
    INPUT lower_bound
    DISPLAY "Enter the upper number:"
    INPUT upper_bound

    WHILE lower_bound >= upper_bound
        DISPLAY "The lower number must be less than the upper number."
        DISPLAY "Enter a new lower number:"
        INPUT lower_bound
        DISPLAY "Enter a new upper number:"
        INPUT upper_bound
    END WHILE

    # Establish the number the player is trying to guess.
    SET secret_number = RANDOM number between lower_bound and upper_bound

    # Play the game.
    DISPLAY "Guess a number between " + lower_bound + " and " + upper_bound + ":"
    INPUT guess

    WHILE guess < lower_bound OR guess > upper_bound
        DISPLAY "That guess is outside the allowed range."
        DISPLAY "Enter a number between " + lower_bound + " and " + upper_bound + ":"
        INPUT guess
    END WHILE

    WHILE guess != secret_number

        IF guess < secret_number THEN
            DISPLAY "Nope, too low!"
        ELSE
            DISPLAY "Nope, too high!"
        END IF

        DISPLAY "Try another number:"
        INPUT guess

        WHILE guess < lower_bound OR guess > upper_bound
            DISPLAY "That guess is outside the allowed range."
            DISPLAY "Enter a number between " + lower_bound + " and " + upper_bound + ":"
            INPUT guess
        END WHILE

    END WHILE

    DISPLAY "You got it! The number was " + secret_number + "."

END hilow_game
