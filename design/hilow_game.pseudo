START hilow_game

    # Establish a valid guessing range.
    PUT "Welcome to the higher/lower game, Bella!"
    PUT "Enter the lower bound:"
    GET lower_bound
    PUT "Enter the upper bound:"
    GET upper_bound

    # Repeat until the lower bound is less than the upper bound.
    WHILE lower_bound >= upper_bound
        PUT "The lower bound must be less than the upper bound."
        PUT "Enter the lower bound:"
        GET lower_bound
        PUT "Enter the upper bound:"
        GET upper_bound
    ENDWHILE

    # Establish the number the player is trying to guess.
    LET secret_number = RANDOM integer from lower_bound to upper_bound (inclusive)

    # Play the game.
    # Get the first guess and repeat until it is inside the range.
    PUT "Great, now guess a number between {lower_bound} and {upper_bound}:"
    GET guess
    WHILE guess < lower_bound OR guess > upper_bound
        PUT "Please enter a number between {lower_bound} and {upper_bound}:"
        GET guess
    ENDWHILE

    # Keep playing until the guess matches the secret number.
    WHILE guess != secret_number
        # Compare the valid guess and give feedback.
        IF guess < secret_number
            PUT "Nope, too low."
        ELSE
            PUT "Nope, too high."
        ENDIF

        # Get another guess and repeat until it is inside the range.
        PUT "Guess another number:"
        GET guess
        WHILE guess < lower_bound OR guess > upper_bound
            PUT "Please enter a number between {lower_bound} and {upper_bound}:"
            GET guess
        ENDWHILE
    ENDWHILE

    # The loop ends only when the guess is correct.
    PUT "You got it!"

END hilow_game
