# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template
#
# Complete the TODO prompts below with your own pseudocode.
# Keep this file in .pseudo format for submission.
#
# Use clear indentation to show decisions and repeated behavior.
# Your finished pseudocode should address every requirement in the
# current Module Four Assignment Guidelines and Rubric.

START hilow_game

    # Establish a valid guessing range.
    OUTPUT "Please enter the lower bound:"
    INPUT lower_bound

    OUTPUT "Please enter the upper bound:"
    INPUT upper_bound

    WHILE lower_bound >= upper_bound DO
        OUTPUT "Invalid entry. The lower bound must be smaller than the upper bound."
        OUTPUT "Please enter the lower bound again:"
        INPUT lower_bound
        OUTPUT "Please enter the upper bound again:"
        INPUT upper_bound
   ENDWHILE
    
    # Establish the number the player is trying to guess.
    target_number = RANDOM_INTEGER(lower_bound, upper_bound)
    guessed_correctly = FALSE
    # Play the game.

    WHILE guessed_correctly IS FALSE DO
        OUTPUT "Enter your guess between " + lower_bound + " and " + upper_bound + ":"
        INPUT user_guess

        # Validate if guess is within bounds
        WHILE user_guess < lower_bound OR user_guess > upper_bound DO
            OUTPUT "Out of range! Enter a number between " + lower_bound + " and " + upper_bound + ":" 
            INPUT user_guess
        ENDWHILE

       IF user_guess < target_number THEN
           OUTPUT "Too low! Try a higher number."
       ELSE IF user_guess > target_number THEN
           OUTPUT "Too high! Try a lower number."
       ELSE
           OUTPUT "Congratulations! You guessed the right number!"
           guessed_correctly = TRUE
       ENDIF
    ENDWHILE
END hilow_game

